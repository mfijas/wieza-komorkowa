{
  "compilerOptions": {
    "target": "ESNext",
    "types": ["vite/client", "@testing-library/jest-dom", "node", "jest"],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // TS 6 requires this to be explicit (TS5011) whenever something actually
    // emits — ts-jest does, even though `tsc` here never does.
    "rootDir": "./src",
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
